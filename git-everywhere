#!/usr/bin/env bash
# git-everywhere (alias gite): version control for directories you can only reach via SFTP, FTP, WebDAV, S3, …
#
# All git work happens on your machine. rclone moves the files: it pulls the server state into a
# local work tree, git commits it, and the history goes back to the server as git bundles,
# one file per snapshot. Nothing needs to run on the server.
#
# Works with bash 3.2 (macOS), git >= 2.28 and rclone >= 1.66.
set -euo pipefail

VERSION=0.4.0
ME=$(basename "$0")
SERVER_REF=refs/everywhere/server
# Marker file in the history folder. rclone skips folders containing it, so the history is never
# downloaded, versioned or deleted, even when it lies inside the synced directory.
MARKER=.git-everywhere-history

die() { echo "$ME: $*" >&2; exit 1; }
info() { echo "==> $*" >&2; }

usage() {
	cat <<EOF
$ME $VERSION - git history for servers without git
Short alias: gite. Also works as: git everywhere

Usage:
  $ME init <remote> [<dir>] [--history <remote>] [--exclude <pattern>]…
                          Create a local copy of <remote> and take the first snapshot.
                          <remote> is anything rclone understands, e.g. myftp:htdocs.
                          --exclude takes rclone filter patterns, e.g. '/cache/**'.
                          If history already exists on the server, it is downloaded.
  $ME snapshot [-m <msg>] Download changes from the server and commit them.
  $ME status              Show what changed on the server since the last snapshot.
  $ME restore <rev> [--yes]
                          Put the server back to the state of commit <rev>.
                          Takes a snapshot first, shows the changes and asks before uploading.
  $ME fetch               Download new history from the server (e.g. after using another machine).
  $ME uninstall [--yes]   Delete the history from the server. Your files there stay untouched,
                          the local copy stays as a plain git repository with the full history.
  $ME help | version

Inside the local copy, use plain git to look around: git log, git diff, git show, …

Environment:
  RCLONE_FLAGS            Extra flags for every rclone call, e.g. "--checksum" or "-v".

Settings live in .git/config (everywhere.remote, everywhere.history),
file filters in .git/everywhere-filter (rclone filter syntax).
EOF
}

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed"; }

# rclone with the user's extra flags (word splitting of RCLONE_FLAGS is intended)
rc() {
	# shellcheck disable=SC2086
	rclone ${RCLONE_FLAGS:-} "$@"
}

# rclone sync between the server and the work tree, with the filters that protect .git and the history
rc_sync() {
	rc sync "$1" "$2" --filter-from "$FILTER" --exclude-if-present "$MARKER" "${@:3}"
}

g() { git -C "$ROOT" "$@"; }

load_root() {
	ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a $ME directory"
	REMOTE=$(g config --get everywhere.remote) || die "$ROOT is not a $ME directory (see '$ME init')"
	HISTORY=$(g config --get everywhere.history) || die "everywhere.history is not set in $ROOT/.git/config"
	FILTER="$ROOT/.git/everywhere-filter"
	BRANCH=$(g symbolic-ref -q --short HEAD) ||
		die "an old commit is checked out. Go back to your branch first, e.g. 'git checkout main'."
}

write_filter() {
	{
		echo "# rclone filter rules (https://rclone.org/filtering/), used for downloads and uploads."
		echo "# Excluded files are neither versioned nor touched on the server."
		echo "# .git on any level: this copy's repository and git repositories on the server"
		echo "- .git/**"
		echo "- .git"
	} >"$FILTER"
}

# Make git store every file exactly as it is: no line ending conversion, no LFS or other filters,
# no ignore files. The history must be able to restore the server byte for byte.
configure_git() {
	g config core.autocrlf false
	g config core.safecrlf false
	g config core.symlinks true
	printf '* -text -filter -ident !eol !working-tree-encoding\n' >"$ROOT/.git/info/attributes"
}

# History on the server: $HISTORY/bundles/<6-digit number>-<commit>.bundle, each holding the commits
# since the previous one. Bundles are only ever added, never changed.

# Bundle names on the server, oldest first. A missing folder means no history, other errors stop.
list_bundles() {
	local out code=0
	out=$(rc lsf --files-only "$HISTORY/bundles" 2>&1) || code=$?
	case $code in
		0) ;;
		3) return 0 ;;
		*) echo "$out" >&2; die "could not list $HISTORY/bundles" ;;
	esac
	printf '%s\n' "$out" | grep -E '^[0-9]{6}-([0-9a-f]{40}|[0-9a-f]{64})\.bundle$' | sort || true
}

bundle_seq() { local n=${1%%-*}; echo $((10#$n)); }
bundle_commit() { local c=${1#*-}; echo "${c%.bundle}"; }

# Sets SERVER_SEQ and SERVER_TIP from the server and refuses to go on if the server has commits
# this copy does not know.
check_history() {
	local bundles latest same
	bundles=$(list_bundles)
	SERVER_SEQ=0 SERVER_TIP=""
	[ -n "$bundles" ] || return 0
	latest=$(printf '%s\n' "$bundles" | tail -n 1)
	SERVER_SEQ=$(bundle_seq "$latest")
	SERVER_TIP=$(bundle_commit "$latest")
	same=$(printf '%s\n' "$bundles" | grep -c "^${latest%%-*}-" || true)
	if [ "$same" -gt 1 ]; then
		die "two copies wrote history at the same time: there are $same bundles numbered ${latest%%-*} in $HISTORY/bundles. Run '$ME fetch', keep the history you want with git, then delete the other bundle on the server."
	fi
	if g cat-file -e "$SERVER_TIP^{commit}" 2>/dev/null &&
		g merge-base --is-ancestor "$SERVER_TIP" HEAD 2>/dev/null; then
		return 0
	fi
	die "the history on the server has commits this copy does not know. Run '$ME fetch' first."
}

create_history() {
	info "Creating history in $HISTORY"
	printf 'This folder holds the history of git-everywhere. Do not delete it while you use git-everywhere.\n' |
		rc rcat "$HISTORY/$MARKER"
	# Most cheap hosting runs Apache: keep the history out of the web if it lies below the webroot
	printf '# written by git-everywhere: the history must not be reachable from the web\nRequire all denied\n' |
		rc rcat "$HISTORY/.htaccess"
	rm -f "$FILTER.uploaded"
}

# Upload the commits since $SERVER_TIP as one new bundle (needs check_history first)
push_history() {
	local tip name tmp
	tip=$(g rev-parse -q --verify HEAD) || return 0
	if [ "$tip" != "$SERVER_TIP" ]; then
		[ -n "$SERVER_TIP" ] || create_history
		name=$(printf '%06d-%s.bundle' $((SERVER_SEQ + 1)) "$tip")
		tmp="$ROOT/.git/everywhere-upload.bundle"
		if [ -n "$SERVER_TIP" ]; then
			g bundle create -q "$tmp" "$BRANCH" "^$SERVER_TIP"
		else
			g bundle create -q "$tmp" "$BRANCH"
		fi
		info "Uploading history to $HISTORY/bundles/$name"
		# Upload under a temporary name and rename, so an interrupted upload never looks like a bundle
		rc copyto "$tmp" "$HISTORY/bundles/$name.partial"
		rc moveto "$HISTORY/bundles/$name.partial" "$HISTORY/bundles/$name"
		rm -f "$tmp"
		g update-ref "$SERVER_REF" "$tip"
		SERVER_SEQ=$((SERVER_SEQ + 1)) SERVER_TIP=$tip
	fi
	# Share the filter, but only upload it when it changed
	if [ -n "$SERVER_TIP" ] && ! cmp -s "$FILTER" "$FILTER.uploaded" 2>/dev/null; then
		rc copyto "$FILTER" "$HISTORY/everywhere-filter"
		cp "$FILTER" "$FILTER.uploaded"
	fi
}

# Take the shared filter from the server unless it was changed here and not uploaded yet
fetch_filter() {
	if [ -f "$FILTER.uploaded" ] && ! cmp -s "$FILTER" "$FILTER.uploaded"; then
		info "Keeping your changes to $FILTER, they will be uploaded with the next snapshot"
		return 0
	fi
	if rc copyto "$HISTORY/everywhere-filter" "$FILTER.new" 2>/dev/null && [ -f "$FILTER.new" ]; then
		mv "$FILTER.new" "$FILTER"
		cp "$FILTER" "$FILTER.uploaded"
	fi
	rm -f "$FILTER.new"
}

# Download and import the bundles this copy does not have yet
fetch_history() {
	local known bundles name new="" tmp ref
	known=$(g rev-parse -q --verify "$SERVER_REF" || true)
	bundles=$(list_bundles)
	[ -n "$bundles" ] || { info "No history on the server"; return 0; }
	fetch_filter
	for name in $bundles; do
		if [ -n "$known" ] && g merge-base --is-ancestor "$(bundle_commit "$name")" "$known" 2>/dev/null; then
			continue
		fi
		new="$new$name
"
	done
	[ -n "$new" ] || { info "History is up to date"; return 0; }

	tmp="$ROOT/.git/everywhere-download"
	rm -rf "$tmp"
	mkdir -p "$tmp"
	printf '%s' "$new" | rc copy "$HISTORY/bundles" "$tmp" --files-from-raw -
	for name in $new; do
		# Take whatever branch the bundle was written from
		ref=$(g bundle list-heads "$tmp/$name" | awk 'NR == 1 { print $2 }')
		[ -n "$ref" ] || die "$name is damaged or contains no branch"
		g fetch -q "$tmp/$name" "+$ref:$SERVER_REF" || die "could not import $name"
	done
	rm -rf "$tmp"
	info "Imported $(printf '%s' "$new" | grep -c .) bundle(s)"

	# Move the branch forward to the server state. The work tree stays as it is,
	# the next snapshot brings it up to date.
	if ! g rev-parse -q --verify HEAD >/dev/null; then
		g update-ref "refs/heads/$BRANCH" "$SERVER_REF"
		g reset -q
	elif g merge-base --is-ancestor HEAD "$SERVER_REF"; then
		g reset -q "$SERVER_REF"
	elif ! g merge-base --is-ancestor "$SERVER_REF" HEAD; then
		die "this copy has commits that are not on the server and the server has commits that are not here. Resolve with git (e.g. 'git reset $SERVER_REF')."
	fi
}

commit() {
	local msg=$1
	# -f: also files that .gitignore files on the server or the user's global ignore list match
	g add -A -f
	if g diff --cached --quiet; then
		info "No changes"
		return 1
	fi
	if g config user.email >/dev/null; then
		g commit -q --no-verify -m "$msg"
	else
		g -c user.name="$ME" -c user.email="$ME@localhost" commit -q --no-verify -m "$msg"
	fi
	g --no-pager show --stat --format='%h %s' HEAD
}

# Print what an rclone sync from $1 to $2 would do: "+ new", "~ changed", "- deleted"
sync_preview() {
	local src=$1 dst=$2 err line
	err="$ROOT/.git/everywhere-preview.log"
	if ! rc_sync "$src" "$dst" --dry-run --combined - 2>"$err" |
		while IFS= read -r line; do
			case $line in
				"+ "* | "- "*) echo "$line" ;;
				"* "*) echo "~ ${line#\* }" ;;
				"! "*) echo "$line" >&2 ;;
			esac
		done; then
		cat "$err" >&2
		rm -f "$err"
		die "could not compare $src with $dst"
	fi
	rm -f "$err"
}

confirm() {
	local answer
	printf '%s [y/N] ' "$1" >&2
	read -r answer || return 1
	case $answer in y | Y | yes | j | J | ja) return 0 ;; *) return 1 ;; esac
}

# Turn a local path into an absolute one, rclone remotes (name:path) stay as they are
absolute() {
	case $1 in
		*:*) echo "$1" ;;
		*)
			local parent base
			parent=$(dirname "$1") base=$(basename "$1")
			parent=$(cd "$parent" 2>/dev/null && pwd) || die "folder $(dirname "$1") does not exist"
			echo "${parent%/}/$base"
			;;
	esac
}

cmd_init() {
	local remote="" dir="" history="" excludes="" existing existed=""
	while [ $# -gt 0 ]; do
		case $1 in
			--history) history=${2:?--history needs a value}; shift 2 ;;
			--exclude) excludes="$excludes- ${2:?--exclude needs a pattern}
"; shift 2 ;;
			-*) die "unknown option $1" ;;
			*)
				if [ -z "$remote" ]; then remote=$1
				elif [ -z "$dir" ]; then dir=$1
				else die "too many arguments"
				fi
				shift
				;;
		esac
	done
	[ -n "$remote" ] || die "usage: $ME init <remote> [<dir>] [--history <remote>] [--exclude <pattern>]"
	case $remote in
		*:*) ;;
		*) [ -d "$remote" ] || die "$remote is neither an rclone remote (name:path) nor a local directory" ;;
	esac
	remote=$(absolute "$remote")
	if [ -z "$dir" ]; then
		dir=${remote%/}
		dir=${dir##*[:/]}
		[ -n "$dir" ] || dir=${remote%%:*}
	fi
	if [ -e "$dir" ]; then
		[ -z "$(ls -A "$dir")" ] || die "$dir exists and is not empty"
		existed=1
	fi
	[ -n "$history" ] || history="${remote%/}.git-everywhere"
	history=$(absolute "$history")

	# The history must not contain the files: uninstall deletes the history
	local r=${remote%/} h=${history%/}
	case $r/ in
		"$h"/*) die "--history must not be the synced folder or contain it" ;;
	esac
	case $h in
		*:) die "--history must not be the root of a remote" ;;
	esac

	mkdir -p "$dir"
	ROOT=$(cd "$dir" && pwd)
	# Do not leave a half-made copy behind if something fails
	if [ -n "$existed" ]; then
		trap 'find "$ROOT" -mindepth 1 -delete 2>/dev/null' EXIT
	else
		trap 'rm -rf "$ROOT"' EXIT
	fi
	# Bundle names and checks assume sha1, whatever the user's default is
	GIT_DEFAULT_HASH=sha1 git init -q -b main "$ROOT"
	REMOTE=$remote
	HISTORY=$history
	FILTER="$ROOT/.git/everywhere-filter"
	BRANCH=main
	g config everywhere.remote "$REMOTE"
	g config everywhere.history "$HISTORY"
	configure_git
	write_filter
	printf '%s' "$excludes" >>"$FILTER"

	existing=$(list_bundles)
	if [ -n "$existing" ]; then
		info "Found history in $HISTORY, downloading it"
		[ -z "$excludes" ] || info "Using the excludes stored on the server, --exclude is ignored"
		fetch_history
	fi

	cd "$ROOT"
	snapshot "Initial snapshot of $REMOTE"
	trap - EXIT
	info "Done. Local copy: $ROOT"
	info "Excludes are in $FILTER. Change them before the history grows, see README."
}

snapshot() {
	local msg=$1 failed=""
	check_history
	info "Downloading changes from $REMOTE"
	rc_sync "$REMOTE" "$ROOT" || failed=1
	commit "$msg" || true
	push_history
	[ -z "$failed" ] ||
		die "some files could not be downloaded (see above). Everything else was saved. Exclude files that can never be read."
}

cmd_snapshot() {
	local msg=""
	while [ $# -gt 0 ]; do
		case $1 in
			-m) msg=${2:?-m needs a message}; shift 2 ;;
			*) die "unknown argument $1" ;;
		esac
	done
	load_root
	[ -n "$msg" ] || msg="Snapshot $(date '+%Y-%m-%d %H:%M:%S')"
	snapshot "$msg"
}

cmd_status() {
	[ $# -eq 0 ] || die "status takes no arguments"
	load_root
	info "Changes on $REMOTE since the last snapshot"
	local changes
	changes=$(sync_preview "$REMOTE" "$ROOT")
	if [ -z "$changes" ]; then
		echo "nothing changed"
	else
		echo "$changes"
	fi
}

cmd_restore() {
	local rev="" yes=""
	while [ $# -gt 0 ]; do
		case $1 in
			--yes | -y) yes=1; shift ;;
			-*) die "unknown option $1" ;;
			*) [ -z "$rev" ] || die "too many arguments"; rev=$1; shift ;;
		esac
	done
	[ -n "$rev" ] || die "usage: $ME restore <rev> [--yes]"
	load_root
	g rev-parse -q --verify "$rev^{commit}" >/dev/null || die "unknown revision $rev"
	rev=$(g rev-parse --short "$rev^{commit}")

	snapshot "Snapshot before restoring $rev"
	g read-tree -u --reset "$rev"

	local changes
	changes=$(sync_preview "$ROOT" "$REMOTE") || { g reset -q --hard HEAD; exit 1; }
	if [ -z "$changes" ]; then
		g reset -q --hard HEAD
		info "The server already matches $rev"
		return 0
	fi
	echo "Changes on $REMOTE:"
	echo "$changes"
	if [ -z "$yes" ] && ! confirm "Upload these changes?"; then
		g reset -q --hard HEAD
		die "aborted, nothing was changed on the server"
	fi
	info "Uploading to $REMOTE"
	rc_sync "$ROOT" "$REMOTE"
	commit "Restore $rev" || true
	push_history
}

cmd_fetch() {
	[ $# -eq 0 ] || die "fetch takes no arguments"
	load_root
	info "Downloading history from $HISTORY"
	fetch_history
	g --no-pager log --oneline -1
}

cmd_uninstall() {
	local yes="" size
	while [ $# -gt 0 ]; do
		case $1 in
			--yes | -y) yes=1; shift ;;
			*) die "unknown argument $1" ;;
		esac
	done
	load_root
	# Refuses if the server has commits this copy does not have, so no history gets lost
	check_history

	if [ "$SERVER_SEQ" -gt 0 ]; then
		size=$(rc size "$HISTORY/bundles" 2>/dev/null | sed -n 's/^Total size: \([^(]*\).*/\1/p' | sed 's/ *$//')
		echo "This deletes the history in $HISTORY from the server ($SERVER_SEQ bundle(s), $size)."
		echo "Your files in $REMOTE are not touched."
		echo "$ROOT stays as a plain git repository with the full history."
		if [ -z "$yes" ] && ! confirm "Delete the history on the server?"; then
			die "aborted, nothing was deleted"
		fi
		info "Deleting the history in $HISTORY"
		# Only delete what git-everywhere wrote, never the whole folder
		rc delete "$HISTORY/bundles" --include '/[0-9][0-9][0-9][0-9][0-9][0-9]-*.bundle' --include '/*.bundle.partial'
		local f
		for f in everywhere-filter .htaccess "$MARKER"; do
			rc deletefile "$HISTORY/$f" 2>/dev/null || true
		done
		rc rmdirs "$HISTORY" 2>/dev/null || true
		if [ -n "$(rc lsf "$HISTORY" 2>/dev/null)" ]; then
			info "Other files in $HISTORY were left alone"
		fi
	else
		info "No history on the server"
	fi

	g config --remove-section everywhere 2>/dev/null || true
	g update-ref -d "$SERVER_REF" 2>/dev/null || true
	rm -f "$FILTER" "$FILTER.uploaded"
	info "Done. $ROOT is now a plain git repository. Delete it with: rm -rf '$ROOT'"
}

main() {
	need git
	need rclone
	local cmd=${1:-help}
	[ $# -gt 0 ] && shift
	case $cmd in
		init) cmd_init "$@" ;;
		snapshot | snap) cmd_snapshot "$@" ;;
		status | st) cmd_status "$@" ;;
		restore) cmd_restore "$@" ;;
		fetch) cmd_fetch "$@" ;;
		uninstall) cmd_uninstall "$@" ;;
		version | --version) echo "$ME $VERSION" ;;
		help | -h | --help) usage ;;
		*) die "unknown command '$cmd' (see '$ME help')" ;;
	esac
}

main "$@"
