#!/usr/bin/env bash
# gite (git-everywhere): version control for directories you can only reach via SFTP, FTP, WebDAV, S3, …
#
# All git work happens on your machine. rclone moves the files: it pulls the server state into a
# local work tree, git commits it, and the history goes back to the server as git bundles,
# one file per snapshot. Nothing needs to run on the server.
#
# Works with bash 3.2 (macOS), git >= 2.28 and rclone.
set -euo pipefail

VERSION=0.2.0
ME=$(basename "$0")
SERVER_REF=refs/everywhere/server

die() { echo "$ME: $*" >&2; exit 1; }
info() { echo "==> $*" >&2; }

usage() {
	cat <<EOF
$ME $VERSION - git history for servers without git

Usage:
  $ME init <remote> [<dir>] [--history <remote>] [--exclude <pattern>]…
                          Create a local copy of <remote> and take the first snapshot.
                          <remote> is anything rclone understands, e.g. myftp:htdocs.
                          --exclude takes rclone filter patterns, e.g. '/cache/**'.
                          If history already exists on the server, it is downloaded.
  $ME snapshot [-m <msg>] Download changes from the server and commit them.
  $ME status              Show what changed on the server since the last snapshot.
  $ME restore <rev> [--yes]
                          Put the server back to the state of commit <rev>.
                          Takes a snapshot first, shows the changes and asks before uploading.
  $ME fetch               Download new history from the server (e.g. after using another machine).
  $ME help | version

Inside the local copy, use plain git to look around: git log, git diff, git show, …

Environment:
  RCLONE_FLAGS            Extra flags for every rclone call, e.g. "--checksum" or "-v".

Settings live in .git/config (everywhere.remote, everywhere.history),
file filters in .git/everywhere-filter (rclone filter syntax).
EOF
}

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed"; }

# rclone with the user's extra flags (word splitting of RCLONE_FLAGS is intended)
rc() {
	# shellcheck disable=SC2086
	rclone ${RCLONE_FLAGS:-} "$@"
}

g() { git -C "$ROOT" "$@"; }

load_root() {
	ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a $ME directory"
	REMOTE=$(g config --get everywhere.remote) || die "$ROOT is not a $ME directory (see '$ME init')"
	HISTORY=$(g config --get everywhere.history) || die "everywhere.history is not set in $ROOT/.git/config"
	FILTER="$ROOT/.git/everywhere-filter"
	BRANCH=$(g symbolic-ref --short HEAD)
}

# Prefix that paths below $REMOTE start with ("host:" stays, "host:dir" becomes "host:dir/")
remote_prefix() {
	case $REMOTE in
		*: | */) echo "$REMOTE" ;;
		*) echo "$REMOTE/" ;;
	esac
}

write_filter() {
	{
		echo "# rclone filter rules (https://rclone.org/filtering/), used for downloads and uploads."
		echo "# Excluded files are neither versioned nor touched on the server."
		echo "- /.git/**"
		local prefix rel
		prefix=$(remote_prefix)
		case $HISTORY in
			"$prefix"*)
				rel=${HISTORY#"$prefix"}
				echo "- /${rel%/}/**"
				;;
		esac
	} >"$FILTER"
}

# History on the server: $HISTORY/bundles/<6-digit number>-<commit>.bundle, each holding the commits
# since the previous one. Bundles are only ever added, never changed.

# Bundle names on the server, oldest first
list_bundles() {
	rc lsf --files-only "$HISTORY/bundles" 2>/dev/null | grep -E '^[0-9]{6}-[0-9a-f]{40}\.bundle$' | sort || true
}

bundle_seq() { local n=${1%%-*}; echo $((10#$n)); }
bundle_commit() { local c=${1#*-}; echo "${c%.bundle}"; }

# Sets SERVER_SEQ and SERVER_TIP from the server and refuses to go on if the server has commits
# this copy does not know.
check_history() {
	local latest
	latest=$(list_bundles | tail -n 1)
	SERVER_SEQ=0 SERVER_TIP=""
	[ -n "$latest" ] || return 0
	SERVER_SEQ=$(bundle_seq "$latest")
	SERVER_TIP=$(bundle_commit "$latest")
	if g cat-file -e "$SERVER_TIP^{commit}" 2>/dev/null &&
		g merge-base --is-ancestor "$SERVER_TIP" HEAD 2>/dev/null; then
		return 0
	fi
	die "the history on the server has commits this copy does not know. Run '$ME fetch' first."
}

# Upload the commits since $SERVER_TIP as one new bundle (needs check_history first)
push_history() {
	local tip name tmp
	tip=$(g rev-parse -q --verify HEAD) || return 0
	[ "$tip" != "$SERVER_TIP" ] || return 0
	name=$(printf '%06d-%s.bundle' $((SERVER_SEQ + 1)) "$tip")
	tmp="$ROOT/.git/everywhere-upload.bundle"
	if [ -n "$SERVER_TIP" ]; then
		g bundle create -q "$tmp" "$BRANCH" "^$SERVER_TIP"
	else
		g bundle create -q "$tmp" "$BRANCH"
	fi
	info "Uploading history to $HISTORY/bundles/$name"
	rc copyto "$tmp" "$HISTORY/bundles/$name"
	rm -f "$tmp"
	g update-ref "$SERVER_REF" "$tip"
	SERVER_SEQ=$((SERVER_SEQ + 1)) SERVER_TIP=$tip
	# Share the filter, but only upload it when it changed
	if ! cmp -s "$FILTER" "$ROOT/.git/everywhere-filter.uploaded"; then
		rc copyto "$FILTER" "$HISTORY/everywhere-filter"
		cp "$FILTER" "$ROOT/.git/everywhere-filter.uploaded"
	fi
}

# Download and import the bundles this copy does not have yet
fetch_history() {
	local known bundles name new="" tmp
	known=$(g rev-parse -q --verify "$SERVER_REF" || true)
	bundles=$(list_bundles)
	[ -n "$bundles" ] || { info "No history on the server"; return 0; }
	for name in $bundles; do
		if [ -n "$known" ] && g merge-base --is-ancestor "$(bundle_commit "$name")" "$known" 2>/dev/null; then
			continue
		fi
		new="$new$name
"
	done
	[ -n "$new" ] || { info "History is up to date"; return 0; }

	tmp="$ROOT/.git/everywhere-download"
	rm -rf "$tmp"
	mkdir -p "$tmp"
	printf '%s' "$new" | rc copy "$HISTORY/bundles" "$tmp" --files-from-raw -
	rc copyto "$HISTORY/everywhere-filter" "$FILTER" 2>/dev/null &&
		cp "$FILTER" "$ROOT/.git/everywhere-filter.uploaded" || true
	for name in $new; do
		g fetch -q "$tmp/$name" "refs/heads/$BRANCH:$SERVER_REF" ||
			die "could not import $name"
	done
	rm -rf "$tmp"
	info "Imported $(printf '%s' "$new" | grep -c .) bundle(s)"

	# Move the branch forward to the server state. The work tree stays as it is,
	# the next snapshot brings it up to date.
	if ! g rev-parse -q --verify HEAD >/dev/null; then
		g update-ref "refs/heads/$BRANCH" "$SERVER_REF"
		g reset -q
	elif g merge-base --is-ancestor HEAD "$SERVER_REF"; then
		g reset -q "$SERVER_REF"
	elif ! g merge-base --is-ancestor "$SERVER_REF" HEAD; then
		die "this copy has commits that are not on the server and the server has commits that are not here. Resolve with git (e.g. 'git reset $SERVER_REF')."
	fi
}

commit() {
	local msg=$1
	g add -A
	if g diff --cached --quiet; then
		info "No changes"
		return 1
	fi
	if g config user.email >/dev/null; then
		g commit -q -m "$msg"
	else
		g -c user.name="$ME" -c user.email="$ME@localhost" commit -q -m "$msg"
	fi
	g --no-pager show --stat --format='%h %s' HEAD
}

# Print the dry-run of an rclone sync as "+ new", "~ changed", "- deleted" lines.
# $3 tells where to look whether a file already exists in the destination:
# "local" (the work tree) or "head" (the last commit, i.e. the server state at the last snapshot).
sync_preview() {
	local src=$1 dst=$2 where=$3 line file
	rc sync "$src" "$dst" --filter-from "$FILTER" --dry-run 2>&1 |
		while IFS= read -r line; do
			case $line in
				*": Skipped copy as --dry-run is set"*)
					file=${line#*NOTICE: }
					file=${file%%: Skipped copy*}
					if { [ "$where" = local ] && [ -e "$ROOT/$file" ]; } ||
						{ [ "$where" = head ] && g cat-file -e "HEAD:$file" 2>/dev/null; }; then
						echo "~ $file"
					else
						echo "+ $file"
					fi
					;;
				*": Skipped delete as --dry-run is set"*)
					file=${line#*NOTICE: }
					file=${file%%: Skipped delete*}
					echo "- $file"
					;;
				*"ERROR"*) echo "$line" >&2 ;;
			esac
		done
}

confirm() {
	local answer
	printf '%s [y/N] ' "$1" >&2
	read -r answer </dev/tty || return 1
	case $answer in y | Y | yes | j | J | ja) return 0 ;; *) return 1 ;; esac
}

cmd_init() {
	local remote="" dir="" history="" excludes=""
	while [ $# -gt 0 ]; do
		case $1 in
			--history) history=${2:?--history needs a value}; shift 2 ;;
			--exclude) excludes="$excludes- ${2:?--exclude needs a pattern}
"; shift 2 ;;
			-*) die "unknown option $1" ;;
			*)
				if [ -z "$remote" ]; then remote=$1
				elif [ -z "$dir" ]; then dir=$1
				else die "too many arguments"
				fi
				shift
				;;
		esac
	done
	[ -n "$remote" ] || die "usage: $ME init <remote> [<dir>] [--history <remote>] [--exclude <pattern>]"
	case $remote in
		*:*) ;;
		*) [ -d "$remote" ] || die "$remote is neither an rclone remote (name:path) nor a local directory" ;;
	esac
	if [ -z "$dir" ]; then
		dir=${remote%/}
		dir=${dir##*[:/]}
		[ -n "$dir" ] || dir=${remote%%:*}
	fi
	if [ -e "$dir" ] && [ -n "$(ls -A "$dir")" ]; then
		die "$dir exists and is not empty"
	fi
	[ -n "$history" ] || history="${remote%/}.git-everywhere"

	mkdir -p "$dir"
	git init -q -b main "$dir"
	ROOT=$(cd "$dir" && pwd)
	REMOTE=$remote
	HISTORY=$history
	FILTER="$ROOT/.git/everywhere-filter"
	BRANCH=main
	g config everywhere.remote "$REMOTE"
	g config everywhere.history "$HISTORY"
	write_filter
	printf '%s' "$excludes" >>"$FILTER"

	if [ -n "$(list_bundles)" ]; then
		info "Found history in $HISTORY, downloading it"
		[ -z "$excludes" ] || info "Using the excludes stored on the server, --exclude is ignored"
		fetch_history
	else
		info "Creating history in $HISTORY"
		# Most cheap hosting runs Apache: keep the history out of the web if it lies below the webroot
		printf '# written by gite (git-everywhere): the history must not be reachable from the web\nRequire all denied\n' |
			rc rcat "$HISTORY/.htaccess"
	fi

	cd "$ROOT"
	snapshot "Initial snapshot of $REMOTE"
	info "Done. Local copy: $ROOT"
	info "Excludes are in $FILTER. Change them before the history grows, see README."
}

snapshot() {
	local msg=$1
	check_history
	info "Downloading changes from $REMOTE"
	rc sync "$REMOTE" "$ROOT" --filter-from "$FILTER"
	commit "$msg" || true
	push_history
}

cmd_snapshot() {
	local msg=""
	while [ $# -gt 0 ]; do
		case $1 in
			-m) msg=${2:?-m needs a message}; shift 2 ;;
			*) die "unknown argument $1" ;;
		esac
	done
	load_root
	[ -n "$msg" ] || msg="Snapshot $(date '+%Y-%m-%d %H:%M:%S')"
	snapshot "$msg"
}

cmd_status() {
	[ $# -eq 0 ] || die "status takes no arguments"
	load_root
	info "Changes on $REMOTE since the last snapshot"
	local changes
	changes=$(sync_preview "$REMOTE" "$ROOT" local)
	if [ -z "$changes" ]; then
		echo "nothing changed"
	else
		echo "$changes"
	fi
}

cmd_restore() {
	local rev="" yes=""
	while [ $# -gt 0 ]; do
		case $1 in
			--yes | -y) yes=1; shift ;;
			-*) die "unknown option $1" ;;
			*) [ -z "$rev" ] || die "too many arguments"; rev=$1; shift ;;
		esac
	done
	[ -n "$rev" ] || die "usage: $ME restore <rev> [--yes]"
	load_root
	g rev-parse -q --verify "$rev^{commit}" >/dev/null || die "unknown revision $rev"
	rev=$(g rev-parse --short "$rev^{commit}")

	snapshot "Snapshot before restoring $rev"
	g read-tree -u --reset "$rev"

	local changes
	changes=$(sync_preview "$ROOT" "$REMOTE" head)
	if [ -z "$changes" ]; then
		info "The server already matches $rev"
		return 0
	fi
	echo "Changes on $REMOTE:"
	echo "$changes"
	if [ -z "$yes" ] && ! confirm "Upload these changes?"; then
		g reset -q --hard HEAD
		die "aborted, nothing was changed on the server"
	fi
	info "Uploading to $REMOTE"
	rc sync "$ROOT" "$REMOTE" --filter-from "$FILTER"
	commit "Restore $rev" || true
	push_history
}

cmd_fetch() {
	[ $# -eq 0 ] || die "fetch takes no arguments"
	load_root
	info "Downloading history from $HISTORY"
	fetch_history
	g --no-pager log --oneline -1
}

main() {
	need git
	need rclone
	local cmd=${1:-help}
	[ $# -gt 0 ] && shift
	case $cmd in
		init) cmd_init "$@" ;;
		snapshot | snap) cmd_snapshot "$@" ;;
		status | st) cmd_status "$@" ;;
		restore) cmd_restore "$@" ;;
		fetch) cmd_fetch "$@" ;;
		version | --version) echo "$ME $VERSION" ;;
		help | -h | --help) usage ;;
		*) die "unknown command '$cmd' (see '$ME help')" ;;
	esac
}

main "$@"
